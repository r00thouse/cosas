  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "/static/icon-192.png?v=__VERSION__", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/static/icon-512.png?v=__VERSION__", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/static/icon-maskable-512.png?v=__VERSION__", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
