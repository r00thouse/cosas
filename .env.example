# Copy to .env (prod, via your secret manager). Local development does not read this
# file: ./dev.sh writes its own dev values to .dev/env, which is gitignored.

# --- HTTP -------------------------------------------------------------------
# Port inside the container and published on every host interface (nginx proxies to
# it, possibly from another host: firewall this port to the proxy). Changing it here
# moves both; keep nginx's proxy_pass in step.
PORT=8080
# Public origin exactly as users see it. No trailing slash.
# Local dev does not use this file: ./dev.sh sets http://localhost:8080 itself.
PUBLIC_ORIGIN=https://cosas.example.org

# --- Storage ----------------------------------------------------------------
# Paths *inside* the container. Leave these alone unless you also change the mounts.
DB_PATH=/data/cosas.db
PHOTO_DIR=/photos
# Host directories bind-mounted by compose.yaml, relative to this directory so that
# backing up the repo copies the database and the images too: DB_DIR is mounted at
# /data, PHOTO_HOST_DIR at /photos. Keep them relative unless the files really live
# elsewhere. Both must be writable by uid 1000.
DB_DIR=./data
PHOTO_HOST_DIR=./photos

# --- Secrets ----------------------------------------------------------------
# Generate with: openssl rand -base64 48
SESSION_SECRET=
# WARNING: rotating CODE_SECRET invalidates every printed sticker forever.
CODE_SECRET=

# --- Kanidm (OIDC, confidential client) -------------------------------------
# Per-client discovery URL:
# https://idm.<domain>/oauth2/openid/<client_id>/.well-known/openid-configuration
OIDC_DISCOVERY_URL=https://idm.example.org/oauth2/openid/cosas/.well-known/openid-configuration
OIDC_CLIENT_ID=cosas
OIDC_CLIENT_SECRET=
# Optional, default "openid profile".
# OIDC_SCOPES=openid profile

# --- Proxy / logging --------------------------------------------------------
# 1 when behind nginx (production), 0 otherwise.
TRUST_PROXY=1
LOG_LEVEL=info

# Optional: 1 only for automated tests that boot the app without a reachable IdP.
# SKIP_DISCOVERY_CHECK=0
