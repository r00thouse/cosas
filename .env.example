# Copy to .env (prod, via your secret manager) or .env.dev (local only).

# --- HTTP -------------------------------------------------------------------
PORT=8080
# Public origin exactly as users see it. No trailing slash.
# Dev compose sets this to http://localhost:8080 itself.
PUBLIC_ORIGIN=https://cosas.example.org

# --- Storage ----------------------------------------------------------------
DB_PATH=/data/cosas.db
# Host directory bind-mounted into /data (compose.yaml).
DB_DIR=./data

# --- Secrets ----------------------------------------------------------------
# Generate with: openssl rand -base64 48
SESSION_SECRET=
# WARNING: rotating CODE_SECRET invalidates every printed sticker forever.
CODE_SECRET=

# --- Kanidm (OIDC, confidential client) -------------------------------------
# Per-client discovery URL:
# https://idm.<domain>/oauth2/openid/<client_id>/.well-known/openid-configuration
OIDC_DISCOVERY_URL=https://idm.example.org/oauth2/openid/cosas/.well-known/openid-configuration
OIDC_CLIENT_ID=cosas
OIDC_CLIENT_SECRET=
# Optional, default "openid profile".
# OIDC_SCOPES=openid profile

# --- Proxy / logging --------------------------------------------------------
# 1 when behind nginx (production), 0 otherwise.
TRUST_PROXY=1
LOG_LEVEL=info

# Optional: 1 only for automated tests that boot the app without a reachable IdP.
# SKIP_DISCOVERY_CHECK=0
