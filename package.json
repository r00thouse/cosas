{
  "name": "hacklab-cosas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file-if-exists=.dev/env --watch server.js",
